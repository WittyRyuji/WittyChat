# Server image: build Go binary + embed admin SPA.
FROM golang:1.27-alpine AS build
WORKDIR /src
RUN apk add --no-cache nodejs npm git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# admin SPA is embedded via server/adminui/dist — build it first.
RUN cd admin && npm install && npm run build && cd ..
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/server ./server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/server /usr/local/bin/wittychat-server
VOLUME /data
EXPOSE 8080
ENTRYPOINT ["wittychat-server", "serve"]
