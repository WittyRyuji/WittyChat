# Worker image: bg_tasks consumer (thumbs, gc, mail, avscan).
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/worker /usr/local/bin/wittychat-worker
VOLUME /data
ENTRYPOINT ["wittychat-worker"]
