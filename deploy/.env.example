# WittyChat production env — copy to .env and fill secrets.
PG_USER=wittychat
PG_PASSWORD=
WITTYCHAT_SECRET_KEY=  # openssl rand -hex 32
PUBLIC_URL=https://im.example.com
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
# Optional S3 (leave empty for local disk storage):
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# OnlyOffice (bundled documentserver container):
# ONLYOFFICE_URL is the browser-facing address of the docs server.
ONLYOFFICE_URL=https://docs.example.com
ONLYOFFICE_JWT_SECRET=  # must match the onlyoffice service's JWT_SECRET
